# Frontend de Citero — variables de entorno.
# Local:   cp .env.example .env.local
# Las NEXT_PUBLIC_* quedan visibles en el navegador y se aplican en el build.

NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Google Maps: restringí la key por dominio en Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
